#!/bin/sh
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 127
script="$here/../swarm-gate/swarm-gate.mjs"
if command -v cygpath >/dev/null 2>&1; then script=$(cygpath -w "$script"); fi
if command -v node >/dev/null 2>&1 && node -e 'process.exit(Number(process.versions.node.split(".")[0]) >= 18 ? 0 : 1)' >/dev/null 2>&1; then
  exec node "$script" "$@"
fi
echo "swarm-gate: Node 18 or newer was not found on PATH" >&2
exit 127
