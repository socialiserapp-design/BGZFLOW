{
  "description": "Native continuity, selective methods and narrow mechanical safety. No reply-blocking stop gates.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/foundation.mjs\"",
            "type": "command",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/foundation.mjs\"",
            "type": "command",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/mechanical-safety.mjs\"",
            "type": "command",
            "timeout": 8
          },
          {
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/foundation.mjs\"",
            "type": "command",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/mechanical-safety.mjs\"",
            "type": "command",
            "timeout": 8
          },
          {
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/foundation.mjs\"",
            "type": "command",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/foundation.mjs\"",
            "type": "command",
            "timeout": 15
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/foundation.mjs\"",
            "type": "command",
            "timeout": 15
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/foundation.mjs\"",
            "type": "command",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/foundation.mjs\"",
            "type": "command",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/foundation.mjs\"",
            "type": "command",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/foundation.mjs\"",
            "type": "command",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/foundation.mjs\"",
            "type": "command",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
